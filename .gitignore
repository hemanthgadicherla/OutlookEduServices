# =========================
# ROOT .gitignore for MERN
# =========================

# Dependencies
node_modules/
**/node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Build folders
dist/
build/
.next/
out/

# Coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Temporary files
*.tmp
*.temp

# =========================
# Backend Ignore
# =========================

backend/node_modules/
backend/uploads/
backend/dist/
backend/build/

# Database files
*.sqlite
*.db

# =========================
# Frontend Ignore
# =========================

frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/build/

# Vercel / Netlify
.vercel/
.netlify/

# =========================
# Misc
# =========================

*.pem
*.key